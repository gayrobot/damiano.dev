// Cloudflare Worker that serves the static Astro build. No server code:
// static asset requests are free and don't count against Workers quotas.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "damiano-dev",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  // The custom domain (damiano.dev) is attached in Milestone 0 step 8, after DNS moves to Cloudflare.
  // preview_urls serves per-PR aliases (pr-N-...) uploaded by .github/workflows/preview.yml.
  "workers_dev": true,
  "preview_urls": true
}
