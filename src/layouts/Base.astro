---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';

interface Props {
  title: string;
  description?: string;
  /** 'reading' = one narrow column (lists, essays, resume). 'wide' = the Home tile grid. */
  width?: 'reading' | 'wide';
}

const {
  title,
  description = 'Skylar Damiano: applied AI, IT and identity work, and notes on working with AI.',
  width = 'reading',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Dark first; light follows the visitor's system. tokens.css handles both. -->
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/alfa-slab-one-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <div class:list={['container', { 'container--wide': width === 'wide' }]}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
