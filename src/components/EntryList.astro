---
// A numbered index of linked entries (projects, musings, any new section).
// The number is a CSS counter, so new entries renumber themselves. Whole row is the link.
// `meta` renders as mono text; `tags` render as Tag components.
import Tag from './Tag.astro';
interface Item {
  href: string;
  title: string;
  summary: string;
  meta?: string;
  tags?: string[];
}
interface Props {
  items: Item[];
  empty?: string;
}
const { items, empty = 'Coming soon.' } = Astro.props;
---

{items.length === 0 && <p class="entry-empty">{empty}</p>}
{items.length > 0 && (
  <ul class="entry-list">
    {items.map((item) => (
      <li>
        <a class="entry" href={item.href}>
          <h2>{item.title}</h2>
          {item.meta && <p class="meta">{item.meta}</p>}
          <p class="summary">{item.summary}</p>
          {item.tags && item.tags.length > 0 && (
            <p class="tags">{item.tags.map((t) => <Tag>{t}</Tag>)}</p>
          )}
        </a>
      </li>
    ))}
  </ul>
)}
