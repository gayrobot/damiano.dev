---
// The harness, shown as a compact spec sheet at the foot of Home, under Featured.
// Only list checks CI actually enforces, so the panel stays proof rather than
// decoration. Intro text goes in the slot.
interface Props {
  label?: string;
  items: { term: string; value: string }[];
}
const { label = 'Spec', items } = Astro.props;
---

<section class="spec" aria-labelledby="spec-title">
  <h2 id="spec-title" class="label">{label}</h2>
  <slot />
  <dl>
    {items.map((i) => (
      <div class="row"><dt>{i.term}</dt><dd>{i.value}</dd></div>
    ))}
  </dl>
</section>
