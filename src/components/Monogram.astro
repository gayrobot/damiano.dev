---
// Skylar's SJ monogram, the exact vector from the letterhead PDF, inlined so it takes
// no request and follows text color. Decorative everywhere it's used.
//   <Monogram class="monogram" />   Home's lavender tile, left of the intro
//   <Monogram class="watermark" />  Resume page, top right behind the text
import mark from '../assets/sj-monogram.svg?raw';
interface Props {
  class?: string;
}
const { class: className = 'monogram' } = Astro.props;
const svg = mark
  .replace(/\s(role|aria-label)="[^"]*"/g, '')
  .replace('<svg ', `<svg class="${className}" aria-hidden="true" focusable="false" `);
---

<Fragment set:html={svg} />
