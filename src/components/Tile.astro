---
// One cell of the Home grid: a link tile to a section, with a thin line icon and its
// nav number set large and faded in the top right corner, like the resume watermark.
// Add a section to nav (with an optional `icon`); Home builds its tile and the grid reflows.
//
// Icons are inlined outline paths from Tabler Icons (MIT, tabler.io/icons), so they take
// no request and follow --color-accent. Add one here when a new section needs it.
const icons = {
  folder: ['M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2'],
  pencil: ['M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4', 'M13.5 6.5l4 4'],
  'file-text': [
    'M14 3v4a1 1 0 0 0 1 1h4',
    'M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z',
    'M9 9l1 0',
    'M9 13l6 0',
    'M9 17l6 0',
  ],
  file: ['M14 3v4a1 1 0 0 0 1 1h4', 'M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z'],
} as const;
export type TileIcon = keyof typeof icons;

interface Props {
  href: string;
  /** The section's nav number, e.g. "02". Decorative; shown large and faded. */
  number: string;
  title: string;
  icon?: TileIcon;
  wide?: boolean;
}
const { href, number, title, icon = 'file', wide = false } = Astro.props;
---

<a class:list={['tile', 'tile--section', { 'tile--wide': wide }]} href={href} data-number={number}>
  <svg class="tile-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    {icons[icon].map((d) => <path d={d} />)}
  </svg>
  <span class="tile-title">{title}</span>
  <span class="arrow" aria-hidden="true">→</span>
</a>
