---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import SdMark from '../components/SdMark.astro';
import Spec from '../components/Spec.astro';
import Tile from '../components/Tile.astro';
import { nav } from '../data/nav';

const featured = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const items = featured.map((p) => ({
  href: `/projects/${p.id}`,
  title: p.data.title,
  summary: p.data.summary,
  meta: `${p.data.status} · ${p.data.date.getUTCFullYear()}`,
}));

// One tile per section, numbered to match its place in the nav.
const shapes = ['circle', 'triangle', 'square'] as const;
const tiles = nav
  .map((item, i) => ({ ...item, number: String(i + 1).padStart(2, '0') }))
  .filter((item) => item.href !== '/')
  .map((item, i) => ({ ...item, shape: shapes[i % shapes.length] }));

// Only what CI and branch protection actually enforce.
const spec = [
  { term: 'Every change', value: 'Pull request' },
  { term: 'Type check and build', value: 'Required' },
  { term: 'Privacy gate', value: 'Required' },
  { term: 'Lighthouse accessibility', value: '100' },
  { term: 'Lighthouse performance, best practices, SEO', value: '90+' },
  { term: 'Hosting', value: 'Static, Cloudflare Workers' },
];
---

<Base title="damiano.dev" width="wide">
  <div class="tile-grid">
    <div class="tile tile--wide tile--hero">
      <div>
        <h1>Hi, I'm Skylar.</h1>
        <p class="lede">
          This site is all about my IT administration career and how I navigate the new world of applied AI in IT.
        </p>
      </div>
    </div>
    <div class="tile tile--panel on-panel">
      <SdMark />
    </div>
    <div class="tile-row">
      {tiles.map((t) => (
        <Tile href={t.href} label={t.number} title={t.label} shape={t.shape} />
      ))}
    </div>
    <Spec items={spec}>
      <p>
        The site itself is part of the project: an AI agent proposes changes as
        pull requests, and I review and merge them.
      </p>
    </Spec>
  </div>

  {items.length > 0 && (
    <section class="featured" aria-labelledby="featured-title">
      <h2 id="featured-title" class="label">Featured</h2>
      <EntryList items={items} />
    </section>
  )}
</Base>
