---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import PageHeader from '../components/PageHeader.astro';

const featured = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const items = featured.map((p) => ({
  href: `/projects/${p.id}`,
  title: p.data.title,
  summary: p.data.summary,
  meta: `Featured project · ${p.data.status} · ${p.data.date.getUTCFullYear()}`,
  tags: p.data.tags,
  url: p.data.url,
}));
---

<Base title="damiano.dev">
  <PageHeader
    title="Hi, I'm Skylar."
    lede="This is where my applied-AI work, my IT and identity experience, and some musings on working with AI will live."
  />
  <p>
    The site itself is part of the project: an AI agent proposes changes as
    pull requests, and I review and merge them.
  </p>
  <p class="note">
    This site is a work in progress. Right now I'm working on the human side of the
    design system: finding the creative inspiration for how it should look and feel.
  </p>
  {items.length > 0 && <EntryList items={items} />}
  <p>
    <a href="/projects">Projects</a> · <a href="/musings">Musings</a> · <a href="/resume">Resume</a>
  </p>
</Base>

<style>
  .note {
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
  }
</style>
