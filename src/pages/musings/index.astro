---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import EntryList from '../../components/EntryList.astro';

// Musings with a parent are "read more" pages, linked only from inside their parent.
const musings = (await getCollection('musings', (m) => !m.data.parent)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const items = musings.map((m) => ({
  href: `/musings/${m.id}`,
  title: m.data.title,
  summary: m.data.summary,
  meta: String(m.data.date.getUTCFullYear()),
}));
---

<Base title="Musings · damiano.dev" width="article">
  <PageHeader title="Musings" />
  <EntryList items={items} />
</Base>
