---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const musings = (await getCollection('musings')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Musings · damiano.dev">
  <h1>Musings</h1>
  {musings.length === 0 && <p>Coming soon.</p>}
  <ul>
    {musings.map((m) => (
      <li>
        <a href={`/musings/${m.id}`}>{m.data.title}</a>
        <br />
        {m.data.summary}
      </li>
    ))}
  </ul>
</Base>
