---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Projects · damiano.dev">
  <h1>Projects</h1>
  {projects.length === 0 && <p>Coming soon.</p>}
  <ul>
    {projects.map((p) => (
      <li>
        <a href={`/projects/${p.id}`}>{p.data.title}</a> ({p.data.status})
        <br />
        {p.data.summary}
      </li>
    ))}
  </ul>
</Base>
