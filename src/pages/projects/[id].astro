---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LiveLink from '../../components/LiveLink.astro';
import PageHeader from '../../components/PageHeader.astro';
import Tag from '../../components/Tag.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, status, tags, date, url } = entry.data;
---

<Base title={`${title} · damiano.dev`} description={summary} width="article">
  <p class="back"><a href="/projects">← All projects</a></p>
  <PageHeader title={title} lede={summary} kicker="Project">
    <p class="details">
      <Tag>{status}</Tag>
      <time datetime={date.toISOString()}>{date.getUTCFullYear()}</time>
      {tags.map((t) => <Tag>{t}</Tag>)}
    </p>
    {url && <p class="actions"><LiveLink href={url} /></p>}
  </PageHeader>
  <div class="prose">
    <Content />
  </div>
</Base>
