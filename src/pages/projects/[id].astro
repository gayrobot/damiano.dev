---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, status, tags, date } = entry.data;
---

<Base title={`${title} · damiano.dev`} description={summary}>
  <h1>{title}</h1>
  <p>
    {status} · <time datetime={date.toISOString()}>{date.getUTCFullYear()}</time>
    {tags.length > 0 && <> · {tags.join(', ')}</>}
  </p>
  <Content />
</Base>
